---
import path from 'node:path'

interface Props {
  id?: string
  src: string | ImageMetadata
  class?: string
  alt?: string
  position?: string
  basePath?: string
  loading?: 'eager' | 'lazy'
  decoding?: 'async' | 'auto' | 'sync'
  fetchpriority?: 'high' | 'low' | 'auto'
  layout?: 'constrained' | 'fixed' | 'full-width' | 'none'
  sizes?: string
}

import { Image } from 'astro:assets'
import { url } from '../../utils/url-utils'

const {
  id,
  src,
  alt,
  position = 'center',
  basePath = '/',
  loading,
  decoding,
  fetchpriority,
  layout,
  sizes,
} = Astro.props
const className = Astro.props.class

const stringSource = typeof src === 'string' ? src : undefined
const isMetadata = typeof src !== 'string'
const isLocalString = Boolean(
  stringSource &&
    !(
      stringSource.startsWith('/') ||
      stringSource.startsWith('http') ||
      stringSource.startsWith('data:')
    ),
)
const isPublic = stringSource?.startsWith('/') ?? false

let img: ImageMetadata | undefined = isMetadata ? src : undefined
if (isLocalString && stringSource) {
  const files = import.meta.glob<ImageMetadata>(
    '../../assets/images/**/*.{png,jpg,jpeg,webp,gif,svg,avif}',
    {
      import: 'default',
    },
  )
  const normalizedPath = path
    .normalize(path.join('../../', basePath, stringSource))
    .replace(/\\/g, '/')
  const file = files[normalizedPath]
  if (file) {
    img = await file()
  } else {
    console.error(
      `\n[ERROR] Image file not found: ${normalizedPath.replace('../../', 'src/')}`,
    )
  }
}

const imageClass = 'w-full h-full object-cover'
const imageStyle = `object-position: ${position}`
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} decoding={decoding} fetchpriority={fetchpriority} layout={layout} sizes={sizes}/>}
    {!img && stringSource && !isLocalString && <img src={isPublic ? url(stringSource) : stringSource} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} decoding={decoding} fetchpriority={fetchpriority}/>}
</div>
