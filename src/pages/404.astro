---
import MainGridLayout from '@layouts/MainGridLayout.astro'
---

<MainGridLayout title="页面未找到" description="请求的页面不存在或尚未缓存">
    <section class="card-base p-8 text-center min-h-64 flex flex-col items-center justify-center">
        <h1 class="text-4xl font-bold text-90 mb-3">404</h1>
        <p class="text-50 mb-5">请求的页面不存在，或者当前离线且尚未缓存该文章</p>
        <a href="/" class="btn-regular rounded-xl h-10 px-5">返回主页</a>
    </section>
</MainGridLayout>
