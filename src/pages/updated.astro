---
import ArchivePanel from '@components/ArchivePanel.astro'
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getRecentlyUpdatedPosts } from '@utils/content-utils'

const posts = await getRecentlyUpdatedPosts()
---

<MainGridLayout title={i18n(I18nKey.recentlyUpdated)} description={i18n(I18nKey.recentlyUpdated)}>
    <h1 class="sr-only">{i18n(I18nKey.recentlyUpdated)}</h1>
    <ArchivePanel posts={posts} dateMode="updated" />
</MainGridLayout>
